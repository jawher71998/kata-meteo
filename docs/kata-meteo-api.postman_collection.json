{
  "info": {
    "name": "KATA Météo - API locale",
    "description": "Tests de l'API KATA Météo. Démarrer le backend (npm run dev dans backend) puis lancer la collection avec le Collection Runner : tous les tests doivent passer. Les dates sont calculées automatiquement par rapport à aujourd'hui.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tunisId",
      "value": "1"
    },
    {
      "key": "cairoId",
      "value": "95"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates relatives à aujourd'hui (UTC, comme le serveur), pour des tests qui ne vieillissent pas",
          "const day = (n) => new Date(Date.now() + n * 86400000).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('today', day(0));",
          "pm.collectionVariables.set('minus1', day(-1));",
          "pm.collectionVariables.set('plus1', day(1));",
          "pm.collectionVariables.set('plus2', day(2));",
          "pm.collectionVariables.set('plus3', day(3));",
          "pm.collectionVariables.set('plus4', day(4));",
          "pm.collectionVariables.set('plus7', day(7));",
          "pm.collectionVariables.set('plus12', day(12));",
          "pm.collectionVariables.set('plus14', day(14));",
          "pm.collectionVariables.set('plus15', day(15));",
          "pm.collectionVariables.set('plus30', day(30));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 - Santé",
      "item": [
        {
          "name": "Santé",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(body.status === \"ok\").to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
